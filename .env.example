# Generate with: openssl rand -hex 32
CERIUM_WEBHOOK_SECRET=replace-with-a-random-shared-secret-at-least-32-characters
WEB_PORT=3000
# Empty: validate against the direct request Host. Set the external origin behind a proxy.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
SYNC_INTERVAL_SECONDS=900
# Optional: docker compose --profile solver up -d --build (upstream license: CC BY-NC 4.0).
# Uncomment for the local sidecar so later deployments also update its shared network.
# COMPOSE_PROFILES=solver
CERIUM_TURNSTILE_SOLVER_URL=http://127.0.0.1:8092
# One-time Sub2API gateway discovery: maximum new groups per sync, 1-20.
CERIUM_MODEL_PROBES_PER_RUN=4
# Optional HTTP(S) egress proxy shared by sync and favicon discovery.
# A host-side proxy must listen on an address reachable from Docker.
# CERIUM_OUTBOUND_PROXY_URL=http://host.docker.internal:7890
# Enable only for a trusted TUN proxy that routes DNS Fake-IP 198.18.0.0/15.
CERIUM_ICON_ALLOW_FAKE_IP=false
# Export HEROUI_SETUP_TOKEN in your shell for the Docker BuildKit secret.
# Do not commit the initialization token or put it in a VITE_* variable.
